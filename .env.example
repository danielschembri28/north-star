# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public address of the app, no trailing slash. Used in review links and webhooks.
BASE_URL=https://app.yourdomain.com
# Postgres connection string (Railway/Render/Neon give you this).
DATABASE_URL=postgres://user:password@host:5432/northstar
# Set to true for most hosted Postgres providers.
DATABASE_SSL=true
# Random string, 32+ characters. Encrypts OAuth tokens. Generate: openssl rand -hex 32
APP_SECRET=
# "live" sends real messages. "console" only logs them (safe for testing).
MESSAGE_MODE=live
# Set to false to make NorthStar invite-only after you create your account.
SIGNUPS_OPEN=true
# Free hosts that sleep (Render free): set RUN_ENGINE=false and call /cron/run?key=CRON_SECRET every 15 min.
RUN_ENGINE=true
CRON_SECRET=
DEFAULT_TIMEZONE=Europe/Malta
DEFAULT_MONTHLY_MESSAGES=500
SUPPORT_EMAIL=

# ── Twilio: SMS and WhatsApp ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Messaging Service (recommended; handles sender IDs per country)…
TWILIO_MESSAGING_SERVICE_SID=
# …or a plain sending number / alphanumeric sender.
TWILIO_SMS_FROM=
# Your approved WhatsApp sender, e.g. +35621000000
TWILIO_WHATSAPP_FROM=
# Content Template SIDs (HX…) approved by Meta. Variables: {{1}} first name, {{2}} business, {{3}} service, {{4}} review link
TWILIO_WHATSAPP_CONTENT_SID_FIRST=
TWILIO_WHATSAPP_CONTENT_SID_FOLLOW=
TWILIO_VALIDATE_WEBHOOKS=true

# ── Email (pick one) ─────────────────────────────────────────────────
EMAIL_FROM=NorthStar <reviews@yourdomain.com>
RESEND_API_KEY=
# smtp://user:pass@smtp.example.com:587
SMTP_URL=

# ── Xero ─────────────────────────────────────────────────────────────
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_WEBHOOK_KEY=
# Default granular scopes (required for Xero apps created after 2 March 2026)
# XERO_SCOPES=openid profile email offline_access accounting.invoices.read accounting.contacts.read

# ── Google Business Profile (review sync + replies) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe billing (optional) ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PLAN_NAME=Growth
PLAN_PRICE_LABEL=€49
PLAN_MONTHLY_MESSAGES=500
