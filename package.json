{
  "name": "northstar",
  "version": "1.0.0",
  "private": true,
  "description": "NorthStar — automated review requests for small businesses",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "seed:demo": "node scripts/seed-demo.js",
    "test": "node --test --test-concurrency=1 test/unit.test.js test/e2e.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.0",
    "pg": "^8.23.1"
  }
}
