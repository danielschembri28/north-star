<%- include('partials/shell-top') %>
<header class="page-head">
  <div class="titles">
    <h1 class="title">Reviews</h1>
    <p class="lede">Every review collected through NorthStar, linked to the customer and job.</p>
  </div>
  <% if (canEdit) { %>
  <div class="row">
    <% if (google) { %><form method="post" action="/reviews/sync" class="inline-form"><%- include('partials/csrf') %><button class="btn secondary" type="submit"><%- h.icon('sync', 18) %>Sync Google</button></form><% } %>
    <a class="btn" href="#add-review">Add a review</a>
  </div>
  <% } %>
</header>

<% if (!google) { %>
<div class="banner info"><span class="txt"><strong>Pull your Google reviews in automatically.</strong> Connect Google Business Profile and new reviews are matched to the customers you asked. Until then, add reviews here by hand.</span><a class="btn sm" href="/integrations">Connect Google</a></div>
<% } %>

<div class="cols">
  <section class="hero-dark">
    <p class="s" style="font-weight:600">All-time average</p>
    <p style="display:flex;align-items:baseline;gap:10px"><span class="big"><%= totals.n ? totals.avg.toFixed(1) : '–' %></span><span aria-label="about <%= totals.n ? totals.avg.toFixed(1) : 0 %> out of 5 stars" style="font-size:22px;color:#F2B630;letter-spacing:2px"><%= h.stars(totals.avg || 0) %></span></p>
    <p class="s"><%= h.plural(totals.n, 'review') %> · <%= totals.google %> on Google, <%= totals.facebook %> on Facebook · <%= totals.linked %> from your requests</p>
  </section>
  <section class="card c2" style="gap:10px;justify-content:center">
    <h2 style="font-size:16px;font-weight:800;margin-bottom:4px">Rating breakdown</h2>
    <% dist.forEach(d => { %>
    <div class="dist-row"><span class="l"><%= d.s %> star<%= d.s === 1 ? '' : 's' %></span><div class="bar"><span style="width: <%= d.w %>%; background: <%= d.s >= 4 ? '#F2B630' : '#8A93A6' %>"></span></div><span class="n"><%= d.n %></span></div>
    <% }) %>
  </section>
</div>

<form class="row" method="get" action="/reviews">
  <div class="chips" role="group" aria-label="Platform">
    <% [['All','All'],['google','Google'],['facebook','Facebook']].forEach(([id, label]) => { %>
      <a class="chip" aria-pressed="<%= platform === id %>" href="<%= h.qs('/reviews', { platform: id, rating: rating === 'all' ? '' : rating, sort: sort === 'newest' ? '' : sort }) %>"><%= label %></a>
    <% }) %>
  </div>
  <% if (platform !== 'All') { %><input type="hidden" name="platform" value="<%= platform %>"><% } %>
  <label class="inline-select" style="margin-left:auto">Rating
    <select name="rating" data-autosubmit><option value="all">All ratings</option><option value="5"<%= rating === '5' ? ' selected' : '' %>>5 stars</option><option value="4"<%= rating === '4' ? ' selected' : '' %>>4 stars</option><option value="low"<%= rating === 'low' ? ' selected' : '' %>>3 stars and below</option></select></label>
  <label class="inline-select">Sort
    <select name="sort" data-autosubmit><option value="newest">Newest first</option><option value="lowest"<%= sort === 'lowest' ? ' selected' : '' %>>Lowest rating first</option></select></label>
  <noscript><button class="btn secondary sm" type="submit">Apply</button></noscript>
</form>

<% if (!list.length) { %>
<div class="empty">
  <%- h.starMark(64, 'none', null).replace('fill="none"', 'fill="none" stroke="#C98A00" stroke-width="1.2"') %>
  <h2><%= totals.n ? 'No reviews match these filters' : 'Your first review is on its way' %></h2>
  <p><%= totals.n ? 'Try a different platform or rating.' : 'Most reviews arrive within two days of the request.' %></p>
  <% if (!totals.n) { %><a href="/activity">See what has been sent</a><% } %>
</div>
<% } %>

<div class="review-grid">
<% list.forEach(rv => { const nm = rv.customer_name || rv.reviewer_name || 'Customer'; %>
  <article class="review-card" id="r-<%= rv.id %>">
    <div class="top"><span class="stars" style="font-size:18px" aria-label="<%= rv.rating %> out of 5 stars"><%= h.stars(rv.rating) %></span><span class="tag"><%= h.platform(rv.platform) %></span><span class="date"><%= h.date(rv.reviewed_at, true) %></span></div>
    <% if (rv.text) { %><p class="text"><%= rv.text %></p><% } else { %><p class="text muted">No written comment.</p><% } %>
    <% if (rv.reply_text) { %><div class="reply"><strong>Your reply:</strong> <%= rv.reply_text %></div><% } %>
    <div class="foot">
      <% if (rv.customer_id) { %><a href="/customers/<%= rv.customer_id %>" class="row" style="gap:8px;text-decoration:none;color:#101828;min-height:44px"><% } else { %><span class="row" style="gap:8px;min-height:44px"><% } %>
        <span class="av sm" aria-hidden="true"><%= h.initials(nm) %></span><span style="display:flex;flex-direction:column"><span style="font-size:14px;font-weight:700"><%= nm %></span><span class="small muted"><%= [rv.service, rv.reference].filter(Boolean).join(' · ') || (rv.request_id ? 'From a review request' : 'Not linked to a request') %></span></span>
      <% if (rv.customer_id) { %></a><% } else { %></span><% } %>
      <% if (canEdit) { %>
      <details class="disclose">
        <summary class="linkish" style="text-decoration:none"><%= rv.reply_text ? 'Edit reply' : rv.rating <= 3 ? 'Reply and make it right' : 'Reply on ' + h.platform(rv.platform) %></summary>
        <form method="post" action="/reviews/<%= rv.id %>/reply" class="stack" style="margin-top:10px;gap:10px"><%- include('partials/csrf') %>
          <label class="field"><span class="sr-only">Your reply</span><textarea name="reply" rows="3" placeholder="Thank you, <%= h.firstName(nm) %>!"><%= rv.reply_text || '' %></textarea></label>
          <div class="row"><button class="btn sm" type="submit"><%= rv.platform === 'google' && google && google.status === 'connected' && rv.external_id ? 'Post reply on Google' : 'Save reply' %></button><% if (!rv.external_id) { %><button class="btn ghost sm" type="submit" formaction="/reviews/<%= rv.id %>/delete" data-confirm="Remove this review from NorthStar?">Remove</button><% } %></div>
        </form>
      </details>
      <% } %>
    </div>
  </article>
<% }) %>
</div>

<% if (hasMore) { %><a class="btn secondary" style="align-self:center" href="<%= h.qs('/reviews', { platform, rating: rating === 'all' ? '' : rating, sort: sort === 'newest' ? '' : sort, show: shown + 24 }) %>">Show more reviews</a><% } %>

<% if (canEdit) { %>
<section class="card" id="add-review">
  <div class="sec-head"><div><h2>Add a review</h2><p>Got a review on Facebook or elsewhere? Log it so your numbers stay complete.</p></div></div>
  <form method="post" action="/reviews" class="stack"><%- include('partials/csrf') %>
    <div class="form-grid">
      <label class="field">Customer
        <select name="customer_id"><option value="">Someone else (type the name)</option><% recentCustomers.forEach(c => { %><option value="<%= c.id %>"><%= c.name %> · asked <%= h.date(c.sent_at) %></option><% }) %></select></label>
      <label class="field">Reviewer name <span class="opt">If not in the list</span><input name="reviewer_name"></label>
      <label class="field">Platform<select name="platform"><option value="google">Google</option><option value="facebook">Facebook</option><option value="other">Other</option></select></label>
      <label class="field">Rating<select name="rating"><option value="5">★★★★★ 5</option><option value="4">★★★★☆ 4</option><option value="3">★★★☆☆ 3</option><option value="2">★★☆☆☆ 2</option><option value="1">★☆☆☆☆ 1</option></select></label>
      <label class="field">Date<input type="date" name="date" value="<%= today %>"></label>
    </div>
    <label class="field">What they wrote <span class="opt">Optional</span><textarea name="text" rows="3"></textarea></label>
    <button class="btn" type="submit" style="align-self:flex-start">Add review</button>
  </form>
</section>
<% } %>
<%- include('partials/shell-bottom') %>
