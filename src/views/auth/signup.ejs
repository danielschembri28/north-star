<%- include("../partials/head") %>
<body>
<div class="auth">
<div class="auth-card">
<a class="brand" href="/"><%- h.starMark(30, "#F2B630", "#FFFFFF") %><span>NorthStar</span></a>
<div class="stack" style="gap:6px"><h1>Start collecting reviews</h1><p class="muted">Create your account. Setup takes about ten minutes.</p></div>
<% if (error) { %><div class="banner error" role="alert"><span class="txt"><%= error %></span></div><% } %>
<form method="post" action="/signup" class="stack">
<label class="field">Your name<input name="name" autocomplete="name" required value="<%= values.name || '' %>"></label>
<label class="field">Business name<input name="business" autocomplete="organization" required value="<%= values.business || '' %>"></label>
<label class="field">Email<input name="email" type="email" autocomplete="email" required value="<%= values.email || '' %>"></label>
<label class="field">Password <span class="hint">At least 10 characters</span><input name="password" type="password" autocomplete="new-password" minlength="10" required></label>
<button class="btn lg" type="submit">Create account</button>
</form>
<p class="small muted">Already have an account? <a href="/login">Sign in</a></p>
</div>
</div>
</body>
</html>
