<%- include("../partials/head") %>
<body>
<div class="auth">
<div class="auth-card">
<a class="brand" href="/"><%- h.starMark(30, "#F2B630", "#FFFFFF") %><span>NorthStar</span></a>
<div class="stack" style="gap:6px"><h1>Join <%= invite.business_name %></h1><p class="muted">You have been invited as <strong><%= {owner:'Owner',manager:'Manager',viewer:'View only'}[invite.role] %></strong> with <strong><%= invite.email %></strong>.</p></div>
<% if (error) { %><div class="banner error" role="alert"><span class="txt"><%= error %></span></div><% } %>
<form method="post" action="/invite/<%= token %>" class="stack">
<% if (existing) { %>
<label class="field">Your NorthStar password<input name="password" type="password" autocomplete="current-password" required></label>
<% } else { %>
<label class="field">Your name<input name="name" autocomplete="name" required></label>
<label class="field">Choose a password <span class="hint">At least 10 characters</span><input name="password" type="password" autocomplete="new-password" minlength="10" required></label>
<% } %>
<button class="btn lg" type="submit">Accept invite</button>
</form>
</div>
</div>
</body>
</html>
